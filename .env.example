# ============================================================
# TMS environment — copy to `.env` and fill in real values.
# ============================================================
# Do NOT commit `.env`.
#   cp .env.example .env
# Generate a session secret with:
#   perl -e 'print join("", map { sprintf "%02x", int rand 256 } 1..64), "\n"'
# ============================================================

# Session signing secret (long random string). REQUIRED in production.
TMS_SECRET=dev-only-change-me

# PostgreSQL connection URL
DATABASE_URL=postgres://tms:tms@localhost:5432/tms

# Optional: override the maintenance DB used by reset_db.pl for DROP/CREATE.
# If unset, reset_db.pl swaps the database name in DATABASE_URL to `postgres`.
# DATABASE_ADMIN_URL=postgres://tms:tms@localhost:5432/postgres

# LibreTranslate endpoint (Task 4 will start the service)
LIBRETRANSLATE_URL=http://localhost:5000

# Gemini API key — leave empty until Task 15
GEMINI_API_KEY=

# ------------------------------------------------------------
# Dev admin — used by script/reset_db.pl and by tests
# ------------------------------------------------------------
TMS_DEV_ADMIN_EMAIL=admin@example.com
TMS_DEV_ADMIN_NAME=Root Admin
TMS_DEV_ADMIN_PASSWORD=ChangeMeStrong!
