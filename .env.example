# ============================================================
# TMS environment — copy to `.env` and fill in real values.
# ============================================================
# Do NOT commit `.env`.
#   cp .env.example .env
# Generate a session secret with:
#   perl -e 'print join("", map { sprintf "%02x", int rand 256 } 1..64), "\n"'
# ============================================================

# Session signing secret (long random string). REQUIRED in production.
TMS_SECRET=dev-only-change-me

# PostgreSQL connection URL (Task 4 will create the database)
DATABASE_URL=postgres://tms:tms@localhost:5432/tms

# LibreTranslate endpoint (Task 4 will start the service)
LIBRETRANSLATE_URL=http://localhost:5000

# Gemini API key — leave empty until Task 15
GEMINI_API_KEY=
